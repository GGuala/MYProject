---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {%- assign rutas = "/,/info/,/cv/,/adquirir/" | split: "," -%}
  {%- for p in site.proyectos -%}{%- assign rutas = rutas | push: p.url -%}{%- endfor -%}
  {%- for r in rutas %}
  {%- assign es = "/es" | append: r %}
  <url>
    <loc>{{ site.url }}{{ r }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ r }}" />
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.url }}{{ es }}" />
  </url>
  <url>
    <loc>{{ site.url }}{{ es }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ r }}" />
    <xhtml:link rel="alternate" hreflang="es" href="{{ site.url }}{{ es }}" />
  </url>
  {%- endfor %}
</urlset>
